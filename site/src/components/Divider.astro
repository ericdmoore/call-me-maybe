  class:list={['deco-divider', { 'deco-divider--home': home }]}
  viewBox="0 0 400 52"
  fill="none"
  stroke="currentColor"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden={home ? undefined : 'true'}
  role={home ? 'presentation' : undefined}
>
  <g stroke="none">
    <g>
      <polygon points="232,20 270,8.6 270,17.4 232,32" fill="currentColor" fill-opacity="0.9" />
      <polygon points="270,8.6 300,25.8 300,32.2 270,17.4" fill="currentColor" fill-opacity="0.78" />
      <polygon points="300,25.8 340,11.8 340,16.2 300,32.2" fill="currentColor" fill-opacity="0.62" />
      <polygon points="340,11.8 368,24.7 368,27.3 340,16.2" fill="currentColor" fill-opacity="0.5" />
      <polygon points="368,24.7 394,21 368,27.3" fill="currentColor" fill-opacity="0.38" />
      <path d="M396 21 l3 3 -3 3 -3 -3 Z" fill="currentColor" fill-opacity="0.55" />
    </g>
    <g transform="translate(400,0) scale(-1,1)">
      <polygon points="232,20 270,8.6 270,17.4 232,32" fill="currentColor" fill-opacity="0.9" />
      <polygon points="270,8.6 300,25.8 300,32.2 270,17.4" fill="currentColor" fill-opacity="0.78" />
      <polygon points="300,25.8 340,11.8 340,16.2 300,32.2" fill="currentColor" fill-opacity="0.62" />
      <polygon points="340,11.8 368,24.7 368,27.3 340,16.2" fill="currentColor" fill-opacity="0.5" />
      <polygon points="368,24.7 394,21 368,27.3" fill="currentColor" fill-opacity="0.38" />
      <path d="M396 21 l3 3 -3 3 -3 -3 Z" fill="currentColor" fill-opacity="0.55" />
    </g>
  </g>

  <g fill="currentColor" stroke="none" opacity="0.75">
    <circle cx="252" cy="40" r="1.7" /><circle cx="268" cy="40" r="1.7" />
    <circle cx="284" cy="40" r="1.7" /><circle cx="300" cy="40" r="1.7" />
    <circle cx="316" cy="40" r="1.7" /><circle cx="332" cy="40" r="1.7" />
    <circle cx="148" cy="40" r="1.7" /><circle cx="132" cy="40" r="1.7" />
    <circle cx="116" cy="40" r="1.7" /><circle cx="100" cy="40" r="1.7" />
    <circle cx="84" cy="40" r="1.7" /><circle cx="68" cy="40" r="1.7" />
  </g>

  <g fill="currentColor" stroke="none">
