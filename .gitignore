# Secrets and local state — never commit these.
.env
policy.toml
handsets.toml
# trunks.toml holds no secrets by design (password_env names a variable), but
# it is local inventory like the two above, and a sub-account username is not
# something to publish either.
trunks.toml
# contacts.toml holds no secrets either (token_env names a variable), but it
# names local paths and whose address books this box reads. The exports it
# points at hold several people's entire contact lists and must never be
# committed — keep them outside the repo, mode 0600.
contacts.toml
*.vcf
!internal/contacts/testdata/*.vcf
asterisk/pjsip.conf
asterisk/ari.conf
# Rendered output: pjsip_handsets.conf contains real SIP passwords.
asterisk/generated/

# Built prompt audio (regenerate with `bash prompts/build.sh`)
prompts/build/

# Build and test output
bin/
dist/
coverage.out
*.out
*.test

*.log
.DS_Store

# Agent worktrees — transient, and gitlinks if they get staged.
.claude/worktrees/
