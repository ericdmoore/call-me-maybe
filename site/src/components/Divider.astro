        <circle cx="-8.8" cy="-8.8" r="2.6" /><circle cx="8.8" cy="-8.8" r="2.6" />
        <circle cx="-8.8" cy="8.8" r="2.6" /><circle cx="8.8" cy="8.8" r="2.6" />
