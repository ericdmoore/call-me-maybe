---
import artwork from '../../../brand/mark-threshold.svg?raw';

/**
 * The way back to the lobby from every other page: the plain Threshold mark
 * and the wordmark, top left, where a visitor expects a site's name to take
 * them home. The browser's back button only retraces steps; someone who
 * arrived at /providers/ from a search has no steps to retrace.
 *
 * The plain rung of the brand's ornateness ladder, on purpose: at two rem the
 * ornate mark collapses into a bright dot (brand/readme.md). Imported from
 * brand/ so there is one drawing to maintain; the file's comment and its own
 * <svg> wrapper are dropped. Its two ids are kept as they are — the mark
 * appears once per page and nothing else on the site uses the
 * `cmm-threshold-` prefix.
 *
 * The doorway lights on hover: the same reward the keypad gives on the home
 * page, promised here in miniature.
 */
const drawing = artwork
  .replace(/<!--[\s\S]*?-->\s*/g, '')
  .replace(/<svg\b[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  // The rays inside the opening get a hook so CSS can turn the light up.
  .replace(
    '<g clip-path="url(#cmm-threshold-open)"',
    '<g class="hl-light" clip-path="url(#cmm-threshold-open)"',
  );

// A redrawn mark that no longer carries the rays would ship a doorway that
// never lights. Fail the build rather than lose the one piece of motion.
if (!drawing.includes('class="hl-light"')) {
  throw new Error('HomeLink: the doorway rays (clip-path cmm-threshold-open) are missing from brand/mark-threshold.svg');
}
if (/<svg\b|<\/svg>/.test(drawing)) {
  throw new Error('HomeLink: the artwork wrapper was not stripped');
}
---

<a href="/" class="home-link" aria-label="Call Me Maybe — home">
  <svg
    class="home-mark"
    viewBox="0 0 100 124"
    fill="none"
    stroke="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <Fragment set:html={drawing} />
  </svg>
  <span class="home-word display">Call Me Maybe</span>
</a>
