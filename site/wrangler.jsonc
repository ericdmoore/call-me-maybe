{
  // Cloudflare Workers deployment for callmemaybe.cc.
  //
  // A Worker that serves static assets and nothing else: there is no `main`,
  // because the site has no server-side work to do. Cloudflare serves ./dist
  // from the edge.
  //
  // Workers rather than Pages for one concrete reason: `wrangler pages` has no
  // domain subcommand, so on Pages the custom domains can only be attached
  // through the dashboard and live nowhere in the repo. Here they are the
  // `routes` array below — reviewable, diffable, and reproducible, which is how
  // the rest of this project treats configuration.
  //
  //   npm run cf:preview   build, then serve through the real Workers runtime
  //   npm run deploy       build, then publish
  //
  // Credentials come from the environment; this repo's .env carries them. .env
  // is gitignored and the pre-push hook refuses a push that tracks it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callmemaybe",
  "compatibility_date": "2026-07-29",

  "assets": {
    "directory": "./dist",
    // Serve the Deco "Good day." page for unknown paths instead of a bare
    // Cloudflare error. Astro builds it from src/pages/404.astro.
    "not_found_handling": "404-page"
  },

  // Gives every deploy a working URL at callmemaybe.<subdomain>.workers.dev,
  // independent of whether the custom domains are attached yet. Keep it on: it
  // is how you verify a deploy without touching the live hostname.
  "workers_dev": true,

  // ── Custom domains ───────────────────────────────────────────────────────
  // Enabled 2026-07-30, once three preconditions were all true: the zone read
  // `active` (not merely delegated), the API token had Zone → DNS → Edit — a
  // custom domain creates a DNS record, so Workers Scripts → Edit alone is not
  // enough — and the site was confirmed working on workers.dev first.
  //
  // Attaching a domain whose zone is still `pending` produces the worst
  // outcome available: a deploy that reports success against a hostname that
  // does not resolve. Verify the zone status before adding a pattern here:
  //
  //   curl -s -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
  //     "https://api.cloudflare.com/client/v4/zones?name=callmemaybe.cc" \
  //     | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"][0]["status"])'
  "routes": [
    { "pattern": "callmemaybe.cc", "custom_domain": true },
    { "pattern": "www.callmemaybe.cc", "custom_domain": true }
  ],

  // dialdoorman.cc is left out on purpose. It is the service brand (2026-10-06):
  // an about page at the apex plus app., login. and store., all served from the
  // private dialdoorman repo, never from this site. Two hostnames serving the
  // same content would also contradict the <link rel="canonical"> in Base.astro.
  // Until the about page ships, wrangler.redirect.jsonc sends the apex here.

  "observability": {
    "enabled": true
  }
}
