#!/bin/bash
set -euo pipefail
: "${REPAIR_HEAD_REF:?}" "${REPAIR_HEAD_SHA:?}" "${AI_POLICY:?}" "${REPAIR_BASE_SHA:?}"
count=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  count=$((count + 1))
  if [[ "$remote_ref" != "$REPAIR_HEAD_REF" || "$remote_sha" != "$REPAIR_HEAD_SHA" ]]; then
    echo 'PR head changed or unexpected push target; request a new repair.' >&2; exit 1
  fi
  git merge-base --is-ancestor "$REPAIR_HEAD_SHA" "$local_sha"
done
[[ "$count" == 1 ]] || { echo 'Exactly one branch update is required'; exit 1; }
bash "$AI_POLICY/validate.sh"
# Recheck after slow validation. Regular git push also enforces fast-forward.
[[ "$(git ls-remote origin "$REPAIR_HEAD_REF" | cut -f1)" == "$REPAIR_HEAD_SHA" ]] || {
  echo 'PR head changed during validation'; exit 1;
}
