---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Divider from '../../components/Divider.astro';
import Switchboard from '../../components/Switchboard.astro';

const features = (await getCollection('features')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Features — Call Me Maybe"
  description="What a house phone can do when the switchboard is yours: ringer ladders, quiet hours, paging, parking, conference, and the rest of the PBX toolkit."
>
  <header class="lobby feat-hero" style="padding-block:clamp(2.5rem,6vw,4rem) 0;">
    <div class="feat-tangle feat-tangle--l"><Switchboard /></div>
    <div class="feat-tangle feat-tangle--r"><Switchboard flip /></div>
    <div class="wrap">
      <p class="eyebrow">The switchboard</p>
      <h1 class="wordmark" style="font-size:clamp(2rem,6vw,3.6rem);">Features</h1>
      <p class="tagline">
        Thirty years of office phone features, now free and open for your home.
      </p>
      <Divider />
    </div>
  </header>

  <section class="panel">
    <div class="wrap">
      <ul class="features">
        {
          features.map((f) => (
            <li>
              <dfn>
                <a href={`/features/${f.id}/`}>{f.data.title}</a>
                {f.data.code && <span class="feat-code">{f.data.code}</span>}
              </dfn>
              <p>{f.data.tagline}</p>
              <p class="feat-who">{f.data.audience}</p>
            </li>
          ))
        }
      </ul>

      <div class="prose" style="margin-top:2.5rem;">
        <p>
          Not one of these is big enough to sell on its own, which is exactly
          why households never got them. They existed for offices, behind a
          five-figure switch and a maintenance contract. Once you own the
          switchboard, a feature stops being a purchase order and becomes a few
          lines of configuration &mdash; which is the entire argument for this
          being free software rather than a product.
        </p>
      </div>
    </div>
  </section>

  <style>
    /* The tangle flanks the title without ever fighting it: absolutely
       positioned, behind, and gone entirely once there is no room. */
    .feat-hero {
      position: relative;
      overflow: hidden;
    }
    .feat-hero > .wrap {
      position: relative;
      z-index: 1;
    }
    .feat-tangle {
      position: absolute;
      top: -2%;
      width: clamp(150px, 19vw, 290px);
      z-index: 0;
    }
    .feat-tangle--l {
      left: max(-3rem, -4vw);
    }
    .feat-tangle--r {
      right: max(-3rem, -4vw);
    }

    /* Below this the hero is a single column and the art would sit under the
       words. Nothing is lost — it was never carrying meaning. */
    @media (max-width: 60rem) {
      .feat-tangle {
        display: none;
      }
    }
  </style>
</Base>
