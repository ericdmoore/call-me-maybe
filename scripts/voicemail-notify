#!/bin/sh
# Call Me Maybe — a new voicemail goes to the house mailbox.
#
# Asterisk runs this as `externnotify` after a message is saved, off the
# call, as its own user, with: <context> <mailbox> <new> [old] [urgent].
# The work is `doorman voicemail notify`: the box's own address from
# voicemail.conf (else MAIL_TO), a transcript when STT_ENDPOINT is set, a
# recording link per VOICEMAIL_LINK_BASE, and one mail through the hook.
# This checks the arguments and starts it detached — its own session, stdin
# from /dev/null, output to syslog as cmm-voicemail — so Asterisk is never
# kept waiting on a transcription. If anything fails the message is still
# in the box and the lamp is still lit: mail is a feed, never the record.
#
# Settings come from /etc/asterisk/cmm-mail.env (0640 root:asterisk), read
# by doorman rather than sourced here (RUNBOOK, "The house mailbox"):
#   MAIL_TO=midbury@example.com          a box with no email of its own
#   MAIL_HOOK=/opt/call-me-maybe/scripts/mail-hook-bullmoose   default
#   STT_ENDPOINT= STT_MODEL= STT_TIMEOUT_MS=                   optional
#   VOICEMAIL_LINK_BASE= VOICEMAIL_LINK_LISTEN= VOICEMAIL_LINK_DAYS=  optional
# and the asterisk user's own bullmoose login.
set -u
ctx="${1:-}"
box="${2:-}"
case "$ctx" in ''|*[!A-Za-z0-9_-]*) echo "voicemail-notify: bad context" >&2; exit 2 ;; esac
case "$box" in ''|*[!A-Za-z0-9_-]*) echo "voicemail-notify: bad mailbox" >&2; exit 2 ;; esac
shift 2
[ "$#" -le 3 ] || { echo "voicemail-notify: too many arguments" >&2; exit 2; }
for count in "$@"; do
  case "$count" in *[!0-9]*) echo "voicemail-notify: bad message count" >&2; exit 2 ;; esac
done

log() { logger -t cmm-voicemail -- "$*" 2>/dev/null || echo "cmm-voicemail: $*" >&2; }

DOORMAN="${DOORMAN:-/opt/call-me-maybe/bin/doorman}"
if [ ! -x "$DOORMAN" ]; then
  DOORMAN=$(command -v doorman 2>/dev/null) || DOORMAN=""
fi
if [ -z "$DOORMAN" ]; then
  log "doorman is not installed; voicemail for $box stays in the box only"
  exit 0
fi

notify() {
  if command -v setsid >/dev/null 2>&1; then
    setsid "$DOORMAN" voicemail notify "$ctx" "$box" "$@"
  else
    "$DOORMAN" voicemail notify "$ctx" "$box" "$@"
  fi
}
if command -v logger >/dev/null 2>&1; then
  ( trap '' HUP; notify "$@" </dev/null 2>&1 | logger -t cmm-voicemail ) </dev/null >/dev/null 2>&1 &
else
  ( trap '' HUP; notify "$@" </dev/null >/dev/null 2>&1 ) </dev/null >/dev/null 2>&1 &
fi
exit 0
