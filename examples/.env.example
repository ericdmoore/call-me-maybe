# ─────────────────────────────────────────────────────────────
# Call Me Maybe — copy to .env and fill in.
#   cp .env.example .env
# Nothing in here is needed by Asterisk itself; Asterisk is
# configured in asterisk/*.conf. This file configures `doorman`.
# ─────────────────────────────────────────────────────────────

# ── Asterisk ARI ─────────────────────────────────────────────
# Must match asterisk/ari.conf and asterisk/http.conf.
# Keep ARI bound to loopback; doorman runs on the same Pi.
ARI_BASE_URL=http://127.0.0.1:8088
ARI_USERNAME=doorman
ARI_PASSWORD=change-me-to-something-long
# Stasis application name. Must match Stasis(...) in extensions.conf.
ARI_APP=doorman
# Reconnect backoff for the event WebSocket.
ARI_RECONNECT_MIN_MS=500
ARI_RECONNECT_MAX_MS=30000
# ARI is effectively full call control — originate, bridge, hang up — behind a
# password that sits in a plaintext file. doorman refuses to start if this host
# is not loopback. The one documented exception is running doorman off-box over
# a tailnet (never the LAN); that needs this set to true and says so in the log.
ARI_ALLOW_REMOTE=false

# ── Configuration files ──────────────────────────────────────
# Three interfaces, three cadences: this file (secrets + tuning, changes
# rarely), handsets.toml (hardware, changes when you buy phones), and
# policy.toml (rules, changes weekly and is safe to hand-edit).
POLICY_PATH=./policy.toml
HANDSETS_PATH=./handsets.toml
# Re-read both files on change so edits go live without a restart.
POLICY_WATCH=true

# ── Handset SIP passwords ────────────────────────────────────
# Referenced by password_env in handsets.toml; `doorman render` substitutes
# them into the generated pjsip_handsets.conf. Generate real ones:
#   openssl rand -base64 18
HANDSET_KITCHEN_PASSWORD=
HANDSET_LIVING_ROOM_PASSWORD=
HANDSET_OFFICE_PASSWORD=
HANDSET_PRIMARY_BED_PASSWORD=
HANDSET_KIDS_ROOM_PASSWORD=

# ── Caller ID normalisation ──────────────────────────────────
# VoIP.ms hands you bare 10-digit, 11-digit, or E.164 depending on the
# originating carrier. Everything is normalised to E.164 before it is
# compared against the allow-list.
DEFAULT_COUNTRY_CODE=1

# ── Lobby behaviour ──────────────────────────────────────────
EXTENSION_LENGTH=6
# Time to dial the FIRST digit, measured from the end of the greeting.
FIRST_DIGIT_TIMEOUT_MS=10000
# Time allowed between subsequent digits.
INTER_DIGIT_TIMEOUT_MS=3000
# How long the house rings before giving up.
RING_TIMEOUT_S=30
# Callers may retry a wrong PIN this many times per call before dismissal.
MAX_PIN_ATTEMPTS=2

# ── Bouncer rate limiting ────────────────────────────────────
# After this many failed calls from one number inside the window, the
# caller skips the greeting entirely and goes straight to "Good day".
RATELIMIT_ENABLED=true
RATELIMIT_MAX_FAILURES=3
RATELIMIT_WINDOW_MS=3600000

# ── Concurrency ceiling ──────────────────────────────────────
# The rate limit above counts failures per caller. It says nothing about a
# flood from many different numbers, which would otherwise keep every handset
# in the house ringing. Calls beyond this are hung up without ringing anything.
# 0 disables the ceiling.
MAX_CONCURRENT_CALLS=5

# ── Prompts ──────────────────────────────────────────────────
# Asterisk media prefix, NOT a filesystem path. Files live in
# /var/lib/asterisk/sounds/<PROMPT_MEDIA_PREFIX>/ — see prompts/build.sh.
PROMPT_MEDIA_PREFIX=call-me-maybe

# ── Logging ──────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info
# "json" for structured lines, "pretty" for a human at a terminal.
LOG_FORMAT=json
# Caller IDs are redacted in logs by default: the caller attribute rides on
# every line a call produces, and journals get shipped and backed up. Setting
# this to false prints full E.164 and is a deliberate debugging opt-out, not a
# state to leave a household in. See CLAUDE.md invariant 1.
LOG_REDACT_CALLER_ID=true

# ─────────────────────────────────────────────────────────────
# Call log — one JSON line per completed call. Off by default.
# ─────────────────────────────────────────────────────────────
# Unset means no call log. Unlike the operational log above, this file holds
# full caller IDs — that is what makes "who called while I was out" answerable
# — so it is created 0600 and is meant to stay on the box. Read it with
# `doorman calls`, which redacts by default; `--no-redact` shows the numbers.
#
# It is written off the call path and can never delay a call: a full buffer
# drops records and counts the drops rather than waiting on the disk.
#
# Nothing on the call path ever reads this file. It is an output.
# CALL_LOG_PATH=/var/lib/doorman/calls.jsonl
# Rotates at this size, keeping one previous generation. 20 calls a day is
# roughly 2 MB a year, so the cap is for the case that is not 20 calls a day.
CALL_LOG_MAX_BYTES=33554432

# ─────────────────────────────────────────────────────────────
# Phase 2 — voicemail. Not wired up yet; parsed and ignored.
# ─────────────────────────────────────────────────────────────
VOICEMAIL_ENABLED=false
# Where Asterisk drops recordings (must be writable by the asterisk user).
VOICEMAIL_RECORDING_DIR=/var/spool/asterisk/recording
VOICEMAIL_MAX_SECONDS=180
# Silence (seconds) that ends a recording early.
VOICEMAIL_SILENCE_SECONDS=5

# Transcription — points at mlx-whisper / faster-whisper on a beefier box.
# Any host the Pi can reach: a LAN name, a tailnet name, or an IP.
STT_ENDPOINT=http://transcribe.example.net:9000/v1/audio/transcriptions
STT_MODEL=whisper-large-v3
STT_TIMEOUT_MS=120000

# Email delivery of the transcript + original audio.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
VOICEMAIL_MAIL_FROM=lobby@example.com
VOICEMAIL_MAIL_TO=you@example.com
