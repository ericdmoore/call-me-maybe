# Call Me Maybe: the service account may ask Asterisk to send a check-sync
# NOTIFY to one phone, through a script that validates the phone's id, and
# nothing else. `doorman provision notify` uses it to tell a phone to fetch
# its configuration again. Installed by install-scripts/ as
# /etc/sudoers.d/doorman-notify, mode 0440.
doorman ALL=(root) NOPASSWD: /opt/call-me-maybe/scripts/notify-check-sync *
