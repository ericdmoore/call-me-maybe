---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import nostalgiaSpammers from '../assets/nostalgia-spammers.png';
import ThresholdScales from '../components/Threshold-scales.astro';
import Divider from '../components/Divider.astro';
import InstallCommand from '../components/InstallCommand.astro';
import Softphones from '../components/Softphones.astro';
import Keypad from '../components/Keypad.astro';
import { byKind, kindLabels, type Kind } from '../data/hardware';

const repo = 'https://github.com/ericdmoore/call-me-maybe';

const features = [
  {
    slug: 'bedtime', term: 'A phone with a bedtime',
    body: 'Handset curfews pause ordinary incoming and outgoing calls. Emergency dialing and scheduled reminder calls remain exceptions.',
  },
  {
    slug: 'contacts', term: 'A familiar address book',
    body: 'Import vCard contact exports for caller screening. Share phone-book entries separately, without changing who gets through.',
  },
  {
    slug: 'home-assistant', term: 'Let the house announce a call',
    body: 'An optional webhook lets Home Assistant announce a caller or signal with a light.',
  },
  {
    slug: 'ringer-ladders',
    term: 'Ringer ladders',
    body: 'Ring the kids’ room for three cycles, escalate to the adults for four more, then take a message. Per extension.',
  },
  {
    slug: 'quiet-hours',
    term: 'Quiet hours',
    body: 'A named schedule like school-night, referenced by any extension. Route calls for that extension to voicemail or an adult during its quiet window.',
  },
  {
    slug: 'paging',
    term: 'Paging',
    body: 'Dial 500 and every handset opens at once. Dinner is ready without shouting up the stairs.',
  },
  {
    slug: 'call-parking',
    term: 'Call parking',
    body: 'Park a call on 700 in the kitchen, pick it up from the office. The house behaves like a small hotel.',
  },
  {
    slug: 'conference',
    term: 'Family conference',
    body: 'Dial 600 and everyone who joins is in the same room. An extension can drop an outside caller straight into it.',
  },
  {
    slug: 'busy-lamps',
    term: 'Busy lamps',
    body: 'BLF hints, so the lamp on your handset tells you the office is already on a call before you pick up.',
  },
  {
    slug: 'voicemail',
    term: 'Voicemail',
    body: 'Per-mailbox, with the message delivered to email. Message-waiting lamps follow whichever box you point a phone at.',
  },
  {
    slug: 'hold-music',
    term: 'Hold music',
    body: 'Because a silent hold is indistinguishable from a dropped call.',
  },
  {
    term: 'Swappable bouncer',
    body: 'The greeting is a folder of audio. Drop in another pack and a Victorian doorman, a bureaucrat, or a ship’s computer meets your strangers instead.',
  },
];

const steps = [
  {
    title: 'Pick your hardware',
    body: 'Start with one PhoneBrain — a Raspberry Pi or MiniPC — and one compatible handset. Add more handsets whenever you’re ready. Give the brain power, storage, a supported Linux system, and a wired connection to your router.',
    link: { href: '#hardware', text: 'Find your hardware' },
  },
  {
    title: 'Get a number',
    body: 'Open a VoIP provider account and choose a phone number. Set up calling credit or billing, and activate emergency calling with your address. You choose the carrier and pay it directly.',
    link: { href: '/providers/', text: 'Compare providers and costs' },
  },
  {
    title: 'Install your doorman',
    body: 'Install doorman and Asterisk on the PhoneBrain, then add the greeting audio. The installer below gets the software started; the setup guide walks you through the rest.',
    link: { href: `${repo}/blob/main/README.md#setup`, text: 'Follow the setup guide' },
  },
  {
    title: 'Hook it all up',
    body: 'Connect your provider and register your handset with the PhoneBrain. Follow the guide yourself, or ask Claude or ChatGPT to help you work through it. You’ll still need to plug in the hardware and set up your provider account.',
    link: { href: '/llms.txt', text: 'Give your AI helper the project guide' },
  },
  {
    title: 'Set your house rules',
    body: 'Choose who rings straight through, give friends an extension, and decide which phones ring when. Add quiet hours or a handset bedtime to suit your household.',
  },
  {
    title: 'Make the first call',
    body: 'Call in from another phone, call out, and check that you can hear each other. Try the lobby from a number outside your known callers, then check your extensions and quiet hours before handing the phone to the family.',
    link: { href: `${repo}/blob/main/docs/RUNBOOK.md`, text: 'Check your setup' },
  },
];

const kinds: Kind[] = ['brain', 'wifi', 'ata', 'dect', 'desk'];
---

<Base
  title="Call Me Maybe — a programmable home phone. Can run on a Raspberry Pi."
  description="Give your family a home phone for calling friends without handing over a smartphone. Open-source, self-hosted calling with room routing, bedtime rules and your choice of provider."
>
  <!-- ── The lobby ──────────────────────────────────────────────────────── -->
  <header class="lobby">
    <div class="wrap">
      <ThresholdScales />

      <Divider />

      <h1 class="wordmark">
        Call Me
        <span class="maybe">Maybe</span>
      </h1>

      <p class="tagline">
        A home phone for calling friends, without handing over a smartphone.
        Your phones, your provider, your house rules.
      </p>

      <p class="tagline tagline-detail">Open-source software you run at home on a Raspberry Pi or another Asterisk host.</p>
      <p><a href="#family-fit">Is this for our family?</a> · <a href="#get-started">How to get started</a> · <a href="/providers/">Compare running costs</a></p>
      <Keypad />
    </div>
  </header>

  <section class="panel" id="family-fit">
    <div class="wrap">
      <p class="eyebrow">A little more independence</p>
      <h2 class="display">Let them make the call</h2>
      <div class="prose">
        <p>Your child wants to call a friend after school. You want that too.
          A shared home phone gives them a place to make plans, tell a story,
          or call Grandma without borrowing your smartphone.</p>
        <p>Choose a simple handset, set up the people who should ring through,
          and give friends an extension for the right room. Add a
          <a href="/features/bedtime/">bedtime for the handset</a> when the day is done.
          Friends can use ordinary phone numbers through your provider; they
          do not need to install Call Me Maybe.</p>
        <p><strong>A good fit if someone in your household is comfortable maintaining
          a small Linux phone system.</strong> You choose the hardware and carrier,
          edit configuration files, and look after updates and account credit.
          A ready-made family phone service may suit you better if you want
          app-based setup and one company handling support.</p>
        <p>The lobby screens incoming calls. It is not an approved-contacts-only
          outgoing dialer: outside a configured curfew, the supplied dialplan
          allows ordinary US/Canada-format numbers. Handsets vary; choose one
          without the apps or screens you are trying to avoid.</p>
        <p>This is a supplementary phone that depends on power, internet and a
          configured provider. Keep another way to reach emergency services.</p>
      </div>
    </div>
  </section>

  <!-- ── The two doors ──────────────────────────────────────────────────── -->
  <section class="panel">
    <div class="wrap">
      <p class="eyebrow">When the phone rings</p>
      <h2 class="display">One decision, Two doors</h2>

      <div class="prose" style="margin-top:1.25rem;">
        <p>
          Known numbers can ring through; other callers hear the lobby and can enter an extension.
          Caller numbers are normalized before comparison, so formatting differences
          do not send Grandma to the wrong door. Caller ID can be spoofed: this is
          call screening, not proof of who is calling.
        </p>
      </div>

      <div class="flow stepped">
        <div>
          <p class="who">For Known Callers</p>
          <p class="said">&ldquo;Welcome, I&rsquo;ll connect you.&rdquo;</p>
          <p class="then">
            Every handset in the house rings at once. The first to answer gets
            the call. A familiar landline experience, subject to your ringing and bedtime rules. No extension needed.
          </p>
        </div>
        <div>
          <p class="who">Everyone Else</p>
          <p class="said">&ldquo;Welcome to the phone lobby. Please dial an extension.&rdquo;</p>
          <p class="then">
            These callers get ten seconds to start dialing an extension. Valid extension rings that room. 
            By default, silence or exhausted attempts gets &ldquo;Good day.&rdquo; and a click. You can also route silence to voicemail or the house.
          </p>
        </div>
      </div>

      <div class="prose" style="margin-top:2rem;">
        <p>
          Ten seconds sounds generous until you watch someone read a number off
          a card. The window is ten seconds to the <em>first</em> digit, then
          three between digits &mdash; so a confident caller is through in two
          seconds and a fumbling one still gets a fair shot.
        </p>
        <p>
          A six-digit code exposed to the phone network is a million
          combinations: ample against a person, thin against a machine that can
          redial. So after three failed calls in an hour, a number skips the
          greeting entirely and goes straight to &ldquo;Good day.&rdquo; &mdash;
          no prompt, no dial window, nothing to work against.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Architecture ───────────────────────────────────────────────────── -->
  <section class="panel">
    <div class="wrap">
      <p class="eyebrow">How is the fit</p>
      <h2 class="display">Secure By Design</h2>

      <div class="prose" style="margin-top:1.25rem;">
        <p>
          The PhoneBrain registers <strong>outbound</strong> to your VoIP provider, and
          incoming calls ride that registration back in. No port forwarding, no
          inbound firewall rules, no dynamic DNS. The only connection crossing
          your network edge is one the Pi opened itself.
        </p>
        <p>
          Asterisk does SIP, RTP, and tone detection, because it is very good at
          those and there is no reason to write them again. Everything about
          <em>who gets in</em> lives in <code>doorman</code>: one static Go
          binary, talking to Asterisk over loopback. One call is one goroutine,
          and a caller hanging up cancels a context that unwinds the whole
          thing.
        </p>
        <p>
          It is also its own operations tool. It will tell you what your
          configuration adds up to, show you how a caller ID normalises, and
          hand a language model the entire config surface as JSON Schema.
        </p>
      </div>

      <div class="terminal" tabindex="0" aria-label="Example terminal session">
        <div><span class="c">$</span> <b>doorman check</b></div>
        <div>&#10003; policy.toml is valid</div>
        <div>&nbsp;</div>
        <div>&nbsp;&nbsp;allow-listed numbers : 4</div>
        <div>&nbsp;&nbsp;extensions&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; : 4</div>
        <div>&nbsp;&nbsp;house ring group&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; : kitchen, living-room, office</div>
        <div>&nbsp;&nbsp;Kids&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; : 2-stage ladder, afterhours configured</div>
        <div>&nbsp;</div>
        <div><span class="c">$</span> <b>doorman e164 &quot;(512) 555-0100&quot;</b></div>
        <div>(512) 555-0100&nbsp;&nbsp;&rarr;&nbsp;&nbsp;+15125550100&nbsp;&nbsp;<span class="c">(usable for the allow-list)</span></div>
      </div>
    </div>
  </section>

  <!-- ── Features ───────────────────────────────────────────────────────── -->
  <section class="panel">
    <div class="wrap">
      <p class="eyebrow">Beyond the lobby</p>
      <h2 class="display">Also A Full Switchboard</h2>

      <div class="prose" style="margin-top:1.25rem;">
        <p>
          Once the handsets are registered, they get the toolkit a small office
          PBX has had for thirty years. It turns out to be a remarkably good fit
          for a house. Each one has <a href="/features/">its own page</a> — who
          it is for, and what it replaces.
        </p>
      </div>

      <ul class="features">
        {
          features.map((f) => (
            <li>
              <dfn>{f.slug ? <a href={`/features/${f.slug}/`}>{f.term}</a> : f.term}</dfn>
              <p>{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Setup ──────────────────────────────────────────────────────────── -->
  <section class="panel" id="get-started">
    <div class="wrap">
      <p class="eyebrow">Make the switch</p>
      <h2 class="display">How to get started</h2>

      <div class="prose" style="margin-top:1.25rem;">
        <p>
          One brain. One handset. Your house, on the line.
          Start small and add a phone in another room whenever you like.
        </p>
      </div>

      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                {s.link && (
                  <p class="step-link">
                    <a href={s.link.href}>{s.link.text} &rarr;</a>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>

      <InstallCommand />

      <div class="prose setup-signoff">
        <p><strong>Park the screens. Pick up the phone. Kick it old-school cool.*</strong></p>
        <details class="setup-meme">
          <summary class="setup-footnote">*The nostalgia is welcome. The spammers get the lobby.</summary>
          <Image
            src={nostalgiaSpammers}
            alt="A doorman holds up his palm to reject Spammers, then smiles and welcomes Nostalgia."
            width={640}
            format="webp"
            loading="lazy"
            class="nostalgia-meme"
          />
        </details>
      </div>
    </div>
  </section>

  <!-- ── Hardware ───────────────────────────────────────────────────────── -->
  <section class="panel" id="hardware">
    <div class="wrap">
      <p class="eyebrow">What to buy</p>
      <h2 class="display">Suggested hardware</h2>

      <div class="prose" style="margin-top:1.25rem;">
        <p>
          <code>doorman</code> has no opinion about brands. Anything that
          registers over SIP works, so buy on ergonomics and price. The type
          matters more than the model: wired desk phones never surprise you,
          DECT is the right answer for cordless, and an ATA means the phones
          already in your house may need nothing bought at all.
        </p>
        <p>
          For the PhoneBrain &mdash; a Raspberry Pi or MiniPC &mdash; one choice is worth being rigid about:
          <strong>use wired Ethernet</strong>. Wi-Fi jitter on the box handling
          audio is the difference between a clear call and someone sounding
          underwater. Then put it on a small UPS &mdash; a house phone that dies
          in a power cut is worse than none, because you thought you had one.
        </p>
      </div>

      {
        kinds.map((kind) => (
          <div class="hw-group">
            <h3>{kindLabels[kind]}</h3>
            <ul class="hw-list">
              {
                byKind(kind).map((item) => (
                  <li>
                    <span class="hw-name">
                      {item.url ? <a href={item.url} rel="nofollow sponsored noopener">{item.name}</a> : item.name}
                    </span>
                    <span class="hw-type">{item.type}</span>
                    <p class="hw-note">{item.note}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }

      <p class="disclosure">
        <strong>Disclosure.</strong> The Amazon links above are affiliate links
        &mdash; buy through one and the project earns a commission at no cost to
        you. Nothing here is sponsored and no vendor has paid for placement. Be
        aware of the obvious bias anyway: every product link in those tables
        earns something, so the honest guidance is the part that does not.
        <code>doorman</code> works with any SIP endpoint, the ATA above may mean
        buying nothing at all, and a free softphone will test your whole ringer
        ladder before you spend a cent.
      </p>

      <Softphones />
    </div>
  </section>

  <!-- ── Footer ─────────────────────────────────────────────────────────── -->
  <footer class="wrap foot">
    <div>
      <p style="margin:0 0 0.35rem;">
        <span class="display" style="font-size:var(--t-xs);color:var(--accent);">Call Me Maybe</span>
      </p>
      <p style="margin:0;">
        Apache 2.0. Bundled audio CC BY-SA 4.0.<br />
        The home phone my kids never saw coming.
      </p>
    </div>
    <nav aria-label="Project links">
      <a href={repo}>Source</a>
      <a href={`${repo}/blob/main/docs/RUNBOOK.md`}>Runbook</a>
      <a href={`${repo}/blob/main/docs/PACKS.md`}>Build a pack</a>
      <a href="/providers/">Providers</a>
      <a href="/hunt/">The hunt</a>
      <a href="/llms.txt">llms.txt</a>
    </nav>
  </footer>
</Base>

<style>
  .tagline-detail {
    font-size: var(--t-sm);
  }

  .step-link {
    margin-top: 0.6rem;
    font-family: var(--display);
    font-size: var(--t-sm);
    letter-spacing: 0.05em;
  }

  .setup-signoff {
    margin-top: 2rem;
  }

  .setup-footnote {
    font-size: var(--t-sm);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.2em;
  }

  .setup-footnote:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .nostalgia-meme {
    display: block;
    width: 100%;
    max-width: 40rem;
    height: auto;
    margin-top: 1rem;
  }
</style>
