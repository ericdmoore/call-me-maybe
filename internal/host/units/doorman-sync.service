# The hosted value sync runs separately from call admission. It observes files
# every second and polls for typed changes every five seconds, backing off with
# jitter (to five minutes, or the service's Retry-After) while passes fail.
# With the sync capability it also holds the bell, an outbound WebSocket that
# only ever says "sync now"; while it is up polling slows to SYNC_BELL_POLL_S
# (300 s), and SYNC_BELL=false in .env turns it off.
# Network and service failures, and a busy account store at startup, are
# retried inside the process; the start limit only counts exits that a restart
# cannot fix (no enrolment, a second sync process), so it stops, not loops.
# Exit 6 is the account owner removing this box: a deliberate sign-out, not a
# fault. It is a clean stop, never restarted; `doorman login` and a restart of
# this unit (or `doorman init services`) bring sync back.
[Unit]
Description=Call Me Maybe — household configuration sync
Documentation=https://callmemaybe.cc
After=network-online.target doorman.service
Wants=network-online.target
ConditionPathExists=/var/lib/doorman/account/tokens.bin
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=doorman
Group=doorman
WorkingDirectory=/opt/call-me-maybe
EnvironmentFile=/opt/call-me-maybe/.env
ExecStart=/opt/call-me-maybe/bin/doorman sync run --state /var/lib/doorman
Restart=on-failure
RestartSec=10
SuccessExitStatus=6
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/call-me-maybe -/var/spool/call-me-maybe/podcasts
StateDirectory=doorman
StateDirectoryMode=0700
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
