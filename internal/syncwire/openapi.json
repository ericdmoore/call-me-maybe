{
  "openapi": "3.1.0",
  "info": {
    "title": "DialDoorman sync transport",
    "version": "1.0.0-draft"
  },
  "paths": {
    "/v1/sync/snapshot": {
      "put": {
        "operationId": "syncSnapshot",
        "security": [
          {
            "boxToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Snapshot"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or idempotent replay",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid strict wire schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid box credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sync capability required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision, generation or receipt conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sync/status": {
      "post": {
        "operationId": "syncStatus",
        "security": [
          {
            "boxToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Status"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or idempotent replay",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid strict wire schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid box credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sync capability required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision, generation or receipt conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sync/receipts": {
      "post": {
        "operationId": "syncReceiptBatch",
        "security": [
          {
            "boxToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReceiptBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or idempotent replay",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiptResults"
                }
              }
            }
          },
          "400": {
            "description": "Invalid strict wire schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid box credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sync capability required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision, generation or receipt conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sync/queue": {
      "get": {
        "operationId": "syncQueue",
        "security": [
          {
            "boxToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pending work; pulling does not acknowledge delivery",
            "content": {
              "application/hal+json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueResult"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "boxToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "A box token with sync capability; browser sessions are not box tokens."
      }
    },
    "schemas": {
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "generation": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "revision": {
            "type": "string",
            "maxLength": 19,
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          }
        },
        "required": ["generation", "revision"]
      },
      "Contact": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 64
                },
                "number": {
                  "type": "string",
                  "maxLength": 16,
                  "pattern": "^\\+[1-9][0-9]{1,14}$"
                }
              },
              "required": ["label", "number"]
            },
            "maxItems": 32
          }
        },
        "required": ["id", "name", "numbers"]
      },
      "Phonebook": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          },
          "label": {
            "type": "string",
            "maxLength": 128
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
            },
            "maxItems": 10000
          },
          "includes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
            },
            "maxItems": 100
          }
        },
        "required": ["id", "label", "contacts", "includes"]
      },
      "Handset": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          },
          "label": {
            "type": "string",
            "maxLength": 128
          },
          "phonebook": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          },
          "pinSet": {
            "type": "boolean"
          }
        },
        "required": ["id", "label", "pinSet"]
      },
      "Schedule": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          },
          "start": {
            "type": "string",
            "maxLength": 5,
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "end": {
            "type": "string",
            "maxLength": 5,
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]
            },
            "maxItems": 7
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["id", "start", "end", "days", "enabled"]
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
          },
          "label": {
            "type": "string",
            "maxLength": 128
          },
          "houseHandsets": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
            },
            "maxItems": 100
          },
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "maxItems": 10000
          },
          "schedules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Schedule"
            },
            "maxItems": 100
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 128
                },
                "handsets": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
                  },
                  "maxItems": 100
                },
                "pinSet": {
                  "type": "boolean"
                },
                "enabled": {
                  "type": "boolean"
                },
                "afterhours": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
                }
              },
              "required": ["id", "label", "handsets", "pinSet", "enabled"]
            },
            "maxItems": 1000
          }
        },
        "required": ["id", "label", "houseHandsets", "people", "schedules", "extensions"]
      },
      "Configuration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handsets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Handset"
            },
            "maxItems": 100
          },
          "contacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "maxItems": 10000
          },
          "phonebooks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Phonebook"
            },
            "maxItems": 1000
          },
          "policies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Policy"
            },
            "maxItems": 100
          },
          "validation": {
            "$ref": "#/components/schemas/ValidationContext"
          }
        },
        "required": ["handsets", "contacts", "phonebooks", "policies"]
      },
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "type": "integer",
            "enum": [1],
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "generation": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "revision": {
            "type": "string",
            "maxLength": 19,
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "replacesGeneration": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "observedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "configuration": {
            "$ref": "#/components/schemas/Configuration"
          }
        },
        "required": ["schema", "generation", "revision", "observedAt", "configuration"]
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "type": "integer",
            "enum": [1],
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "version": {
            "type": "string",
            "maxLength": 64
          },
          "sampledAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "diskFreeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "diskTotalBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "memoryAvailableBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "memoryTotalBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "cpuUtilization": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "handsets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
                },
                "registered": {
                  "type": "boolean"
                },
                "directoryRevision": {
                  "type": "string",
                  "maxLength": 19,
                  "pattern": "^(0|[1-9][0-9]{0,18})$"
                }
              },
              "required": ["id", "registered", "directoryRevision"]
            },
            "maxItems": 100
          },
          "contentInventory": {
            "$ref": "#/components/schemas/ContentInventory"
          }
        },
        "required": ["schema", "version", "sampledAt"]
      },
      "Verb": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "enum": ["policy.setSchedule"]
              },
              "policy": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
              },
              "schedule": {
                "$ref": "#/components/schemas/Schedule"
              }
            },
            "required": ["name", "policy", "schedule"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "enum": ["phonebook.assign"]
              },
              "handset": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
              },
              "phonebook": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
              }
            },
            "required": ["name", "handset", "phonebook"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "enum": ["contacts.upsert"]
              },
              "contact": {
                "$ref": "#/components/schemas/Contact"
              }
            },
            "required": ["name", "contact"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "enum": ["backup.run"]
              }
            },
            "required": ["name"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "enum": ["contacts.refresh"]
              }
            },
            "required": ["name"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "enum": ["provision.notify"]
              },
              "handsets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,63}$"
                },
                "maxItems": 100
              }
            },
            "required": ["name", "handsets"]
          }
        ]
      },
      "Proposal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "base": {
            "$ref": "#/components/schemas/Version"
          },
          "notAfter": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "verb": {
            "$ref": "#/components/schemas/Verb"
          }
        },
        "required": ["id", "base", "notAfter", "verb"]
      },
      "QueueItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "base": {
            "$ref": "#/components/schemas/Version"
          },
          "notAfter": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          },
          "verb": {
            "$ref": "#/components/schemas/Verb"
          },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["person"]
              },
              "person": {
                "type": "string",
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": ["kind", "person"]
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-go-type": "int64"
          }
        },
        "required": ["id", "base", "notAfter", "verb", "author", "createdAt"]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "generation": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "saved",
              "applied",
              "duplicate",
              "stale",
              "conflict",
              "rejected",
              "failed"
            ]
          },
          "revision": {
            "type": "string",
            "maxLength": 19,
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "problem": {
            "type": "string",
            "enum": [
              "invalid",
              "unsupported",
              "expired",
              "base_changed",
              "needs_reload",
              "execution_failed"
            ]
          }
        },
        "required": ["id", "generation", "status"]
      },
      "ReceiptBatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "receipts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Receipt"
            },
            "maxItems": 100
          }
        },
        "required": ["receipts"]
      },
      "PolicyValues": {
        "type": "object",
