{
  "name": "callmemaybe-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute callmemaybe-edge --remote --file=./schema.sql && wrangler d1 migrations apply callmemaybe-edge --remote",
    "db:migrate": "wrangler d1 migrations apply callmemaybe-edge --remote",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.120.0"
  }
}
