# ─────────────────────────────────────────────────────────────
# Call Me Maybe — copy to .env and fill in.
#   cp .env.example .env
# Nothing in here is needed by Asterisk itself; Asterisk is
# configured in asterisk/*.conf. This file configures `doorman`.
# ─────────────────────────────────────────────────────────────

# ── Asterisk ARI ─────────────────────────────────────────────
# Must match asterisk/ari.conf and asterisk/http.conf.
# Keep ARI bound to loopback; doorman runs on the same Pi.
ARI_BASE_URL=http://127.0.0.1:8088
ARI_USERNAME=doorman
ARI_PASSWORD=change-me-to-something-long
# Stasis application name. Must match Stasis(...) in extensions.conf.
ARI_APP=doorman
# Reconnect backoff for the event WebSocket.
ARI_RECONNECT_MIN_MS=500
ARI_RECONNECT_MAX_MS=30000
# ARI is effectively full call control — originate, bridge, hang up — behind a
# password that sits in a plaintext file. doorman refuses to start if this host
# is not loopback. The one documented exception is running doorman off-box over
# a tailnet (never the LAN); that needs this set to true and says so in the log.
ARI_ALLOW_REMOTE=false

# ── Configuration files ──────────────────────────────────────
# Interfaces and cadences: this file (secrets + tuning, changes rarely),
# handsets.toml (hardware, changes when you buy phones), policy.toml (rules,
# changes weekly and is safe to hand-edit), and optionally trunks.toml (the
# providers, changes when you buy a number somewhere new).
POLICY_PATH=./policy.toml
HANDSETS_PATH=./handsets.toml
# Re-read policy and handsets on change so edits go live without a restart.
POLICY_WATCH=true
# The provider inventory is OPTIONAL, and no file is the normal state: one
# provider, one registration, a hand-written pjsip.conf, and `doorman render`
# generates only the handset config. Create one to make adding a second
# provider a TOML block — see examples/trunks.example.toml. The daemon reads it
# for exactly one thing: saying at startup which trunk carries 911.
TRUNKS_PATH=./trunks.toml
# The address-book inventory is OPTIONAL too, and no file is the normal state:
# nothing is read, nothing is logged, and [[people]] is the only list that
# admits anybody. It names vCard exports to read so the phone can see the
# contact list your household already curates — see contacts.example.toml. With
# one, a personal contact goes straight through, a published one hears the
# lobby, and a blocked one is dismissed without hearing it at all. [[people]]
# still beats the classifier.
CONTACTS_PATH=./contacts.toml

# ── Handset SIP passwords ────────────────────────────────────
# Referenced by password_env in handsets.toml; `doorman render` substitutes
# them into the generated pjsip_handsets.conf. Generate real ones:
#   openssl rand -base64 18
HANDSET_KITCHEN_PASSWORD=
HANDSET_LIVING_ROOM_PASSWORD=
HANDSET_OFFICE_PASSWORD=
HANDSET_PRIMARY_BED_PASSWORD=
HANDSET_KIDS_ROOM_PASSWORD=

# ── Trunk registration passwords ─────────────────────────────
# Only needed with a trunks.toml. Referenced by password_env there, exactly as
# the handset passwords are referenced from handsets.toml; `doorman render`
# substitutes them into the generated pjsip_trunks.conf. The convention is
# TRUNK_<ID>_PASSWORD, and the loader refuses a password_env that is not shaped
# like a variable name — so a password pasted into trunks.toml fails loudly
# rather than being committed.
#TRUNK_VOIPMS_PASSWORD=

# ── Provider API passwords — for `doorman balance` only ──────
# Referenced by api_password_env in trunks.toml, and read by `doorman balance`
# and by nothing else. THE DAEMON NEVER READS THESE.
#
# That is deliberate rather than an oversight. A provider's API key manages
# DIDs, sub-accounts and billing; the SIP password above can only make calls.
# Keeping the balance check in a CLI keeps the higher-privilege key off the
# call path and out of the long-running process — and the check is best run
# wherever your alerting already lives rather than on the Pi:
#
#   doorman balance --json    # exits 1 when a trunk is under its threshold
#
# needs a copy of trunks.toml and this variable, and no daemon at all.
#TRUNK_VOIPMS_API_PASSWORD=

# ── Caller ID normalisation ──────────────────────────────────
# VoIP.ms hands you bare 10-digit, 11-digit, or E.164 depending on the
# originating carrier. Everything is normalised to E.164 before it is
# compared against the allow-list.
DEFAULT_COUNTRY_CODE=1

# ── Lobby behaviour ──────────────────────────────────────────
EXTENSION_LENGTH=6
# Time to dial the FIRST digit, measured from the end of the greeting.
FIRST_DIGIT_TIMEOUT_MS=10000
# Time allowed between subsequent digits.
INTER_DIGIT_TIMEOUT_MS=3000
# How long the house rings before giving up.
RING_TIMEOUT_S=30
# Callers may retry a wrong PIN this many times per call before dismissal.
MAX_PIN_ATTEMPTS=2

# ── Bouncer rate limiting ────────────────────────────────────
# After this many failed calls from one number inside the window, the
# caller skips the greeting entirely and goes straight to "Good day".
RATELIMIT_ENABLED=true
RATELIMIT_MAX_FAILURES=3
RATELIMIT_WINDOW_MS=3600000

# ── Concurrency ceiling ──────────────────────────────────────
# The rate limit above counts failures per caller. It says nothing about a
# flood from many different numbers, which would otherwise keep every handset
# in the house ringing. Calls beyond this are hung up without ringing anything.
# 0 disables the ceiling.
MAX_CONCURRENT_CALLS=5

# ── Prompts ──────────────────────────────────────────────────
# Asterisk media prefix, NOT a filesystem path. Files live in
# /var/lib/asterisk/sounds/<PROMPT_MEDIA_PREFIX>/ — see prompts/build.sh.
PROMPT_MEDIA_PREFIX=call-me-maybe

# ── Logging ──────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info
# "json" for structured lines, "pretty" for a human at a terminal.
LOG_FORMAT=json
# Caller IDs are redacted in logs by default: the caller attribute rides on
# every line a call produces, and journals get shipped and backed up. Setting
# this to false prints full E.164 and is a deliberate debugging opt-out, not a
# state to leave a household in. See CLAUDE.md invariant 1.
LOG_REDACT_CALLER_ID=true

# ─────────────────────────────────────────────────────────────
# Pack building — workstation only, never read by the daemon.
# ─────────────────────────────────────────────────────────────
# `doorman pack build` renders prompts to audio. None of this runs on the Pi:
# prompts are built once here and committed as WAVs (CLAUDE.md invariant 7).
# Credentials come from the environment, never from a pack — a pack is a file
# you downloaded.
#
# PIPER_CMD=piper                 # the free, local, offline default
# PIPER_VOICE_DIR=~/.local/share/piper
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=              # Polly; AWS_REGION defaults to us-east-1
# AWS_SECRET_ACCESS_KEY=
# VOICE_EXEC_CMD=                 # any command: text on stdin, PCM on stdout
# VOICE_EXEC_ARGS=

# ─────────────────────────────────────────────────────────────
# Call log — one JSON line per completed call. Off by default.
# ─────────────────────────────────────────────────────────────
# Unset means no call log. Unlike the operational log above, this file holds
# full caller IDs — that is what makes "who called while I was out" answerable
# — so it is created 0600 and is meant to stay on the box. Read it with
# `doorman calls`, which redacts by default; `--no-redact` shows the numbers.
#
# It is written off the call path and can never delay a call: a full buffer
# drops records and counts the drops rather than waiting on the disk.
#
# Nothing on the call path ever reads this file. It is an output.
# CALL_LOG_PATH=/var/lib/doorman/calls.jsonl
# Rotates at this size, keeping one previous generation. 20 calls a day is
# roughly 2 MB a year, so the cap is for the case that is not 20 calls a day.
CALL_LOG_MAX_BYTES=33554432

# ─────────────────────────────────────────────────────────────
# Event webhook — how the house finds out. Off by default.
# ─────────────────────────────────────────────────────────────
# Unset means no webhook. Set it and doorman POSTs one JSON object when the
# house starts ringing and one when a call ends, so Home Assistant can announce
# "call from Grandma" on the kitchen speaker or flash a light.
#
# The payload is an EVENT — what happened, who, and how it ended. It never
# names a speaker, a media_player entity, or any routing: HA already models the
# house's devices and decides which of them hear it. That indirection is the
# whole design, and it is why Sonos, Cast, MQTT and everything else HA supports
# come free without doorman learning what a speaker is.
#
#   {"event":"ringing","at":"...","call_id":"...","caller":"+1512•••0100",
#    "known":"Grandma"}
#   {"event":"completed",...,"outcome":"answered","answered_by":"PJSIP/kitchen",
#    "ms":18420}
#
# Posted off the call path and bounded by a short timeout, so a dead or slow
# Home Assistant can never delay a call: a full buffer drops events and counts
# them rather than waiting on the network.
#
# TREAT THE URL AS A SECRET. A Home Assistant webhook id is the whole
# credential, which is why doorman only ever logs the host.
# WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/call-me-maybe
# Sent as `Authorization: Bearer`. HA's /api/webhook/<id> needs nothing here;
# its REST API and most other receivers do.
# WEBHOOK_TOKEN=
# One delivery attempt. Short on purpose — a notification that arrives late has
# already missed the ring it was describing. Also bounds shutdown.
WEBHOOK_TIMEOUT_MS=3000
# Caller IDs are redacted in the payload by default — the OPPOSITE of the call
# log above, deliberately: that is a 0600 file that stays on the box, this is
# handed to another program over the network. Set false when the receiver needs
# the full number, e.g. to announce an unknown caller. Entered digits and PINs
# are never sent at any setting.
WEBHOOK_REDACT_CALLER_ID=true

# ─────────────────────────────────────────────────────────────
# Phase 2 — voicemail. Not wired up yet; parsed and ignored.
# ─────────────────────────────────────────────────────────────
VOICEMAIL_ENABLED=false
# Where Asterisk drops recordings (must be writable by the asterisk user).
VOICEMAIL_RECORDING_DIR=/var/spool/asterisk/recording
VOICEMAIL_MAX_SECONDS=180
# Silence (seconds) that ends a recording early.
VOICEMAIL_SILENCE_SECONDS=5

# Transcription — points at mlx-whisper / faster-whisper on a beefier box.
# Any host the Pi can reach: a LAN name, a tailnet name, or an IP.
STT_ENDPOINT=http://transcribe.example.net:9000/v1/audio/transcriptions
STT_MODEL=whisper-large-v3
STT_TIMEOUT_MS=120000

# Email delivery of the transcript + original audio.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
VOICEMAIL_MAIL_FROM=lobby@example.com
VOICEMAIL_MAIL_TO=you@example.com
