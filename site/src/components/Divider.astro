---
import artwork from '../../../brand/mark-threshold.svg?raw';

/**
 * Section divider: the dial rosette between two lightning bolts. Source of
 * truth is brand/ornament-dial-divider.svg — change one, change both.
 *
 * The bolts are not licence: pulse dialling works by making and breaking the
 * current, so the sparks leaving the dial are what the object actually does.
 *
 * With `home`, the rosette gives way to the plain Threshold mark and that
 * mark is the link to the lobby: HomeNav.astro's masthead on every page but
 * the lobby. The plain rung of the brand's ornateness ladder, on purpose: at
 * this size the ornate mark is a bright dot (brand/readme.md). It lights on
 * hover, the reward the keypad gives on the home page, promised here in
 * miniature.
 *
 * The plain divider is deliberately id-free, so it can appear as many times
 * on a page as you like; the mirrored bolt is written out rather than
 * referenced. The home variant is the exception: it inlines the mark, whose
 * mask and clip-path carry ids, so it belongs once per page — the masthead.
 */
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;

// The mark, imported so there is one drawing to maintain: its comment and
// its own <svg> wrapper dropped, and the rays inside the opening given a
// hook so CSS can turn the light up. In the template it is cropped to its
// ink and sized to stand where the dial stood; the transparent rect behind
// it is the tap target — painted but invisible, so it takes the pointer.
const drawing = artwork
  .replace(/<!--[\s\S]*?-->\s*/g, '')
  .replace(/<svg\b[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replace(
    '<g clip-path="url(#cmm-threshold-open)"',
    '<g class="hl-light" clip-path="url(#cmm-threshold-open)"',
  );

// A redrawn mark that no longer carries the rays would ship a doorway that
// never lights. Fail the build rather than lose the one piece of motion.
if (home && !drawing.includes('class="hl-light"')) {
  throw new Error('Divider: the doorway rays (clip-path cmm-threshold-open) are missing from brand/mark-threshold.svg');
}
if (home && /<svg\b|<\/svg>/.test(drawing)) {
  throw new Error('Divider: the artwork wrapper was not stripped');
}
---

