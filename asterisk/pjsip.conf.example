; ─────────────────────────────────────────────────────────────
; Call Me Maybe — PJSIP
;
; Trunk side: the Pi REGISTERs outbound to VoIP.ms. `line=yes` +
; `endpoint=voipms` binds inbound calls on that registration back to
; the endpoint below — no provider IP allow-list, no port forwarding.
; VoIP.ms does not echo the ;line= tag back, so the two `identify`
; blocks after the endpoint match the call by OUR identity (sub-account
; and DID) instead. Both belong; neither is an IP.
;
; Handset side: Grandstreams register inward to Asterisk on the LAN.
; ─────────────────────────────────────────────────────────────

[global]
type=global
; Keepalives hold the NAT pinhole open. 30s is comfortably inside the
; UDP timeout on consumer routers (eero included).
keep_alive_interval=30
endpoint_identifier_order=ip,username,anonymous

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
; Uncomment and set if the Pi ever sits behind a router that mangles SIP.
;local_net=192.168.1.0/24
;external_media_address=
;external_signaling_address=

; ─── VoIP.ms trunk ───────────────────────────────────────────
; Replace 123456_home with your SUB ACCOUNT (Main Menu -> Sub Accounts),
; not your main VoIP.ms login. Replace POP with your chosen server,
; e.g. dallas.voip.ms / atlanta.voip.ms — use the same host everywhere.
;
; ── More than one provider? ──────────────────────────────────
; This block is one worked example, hand-maintained, and it is the right
; answer for one provider. With several it becomes copy-and-paste, and the
; detail below that must not be got wrong (line=yes + endpoint=) is exactly
; the kind that gets lost in a copy.
;
; trunks.toml is the alternative: declare each provider once, run
; `doorman render`, and get this block generated per trunk with the
; passwords substituted from .env. To switch: create trunks.toml (see
; examples/trunks.example.toml), DELETE the four objects below, and
; uncomment the include. Leaving both in place registers twice.
;
;#include "pjsip_trunks.conf"

[voipms_auth]
type=auth
auth_type=userpass
username=123456_home
password=CHANGE_ME

[voipms_reg]
type=registration
outbound_auth=voipms_auth
server_uri=sip:POP.voip.ms
client_uri=sip:123456_home@POP.voip.ms
contact_user=123456_home
retry_interval=60
forbidden_retry_interval=600
expiration=300
line=yes
endpoint=voipms

[voipms_aor]
type=aor
contact=sip:POP.voip.ms
qualify_frequency=60

[voipms]
type=endpoint
context=inbound-trunk
disallow=all
allow=ulaw
allow=g722
outbound_auth=voipms_auth
aors=voipms_aor
; No from_user. With it set to the sub-account, every outbound INVITE
; presents the sub-account name as the caller and VoIP.ms answers 503:
; it wants the DID you own in From, which is what CALLERID(num) —
; OUTBOUND_CID from doorman render — puts there when this is left alone.
from_domain=POP.voip.ms
; Transcoding is wasted CPU on a Pi; let the endpoints negotiate directly
; where they can, but keep media on the box so we can bridge and record.
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
; DTMF: RFC2833 is what VoIP.ms sends. Without this the lobby never
; hears an extension.
dtmf_mode=rfc4733

; ─── Inbound identification ──────────────────────────────────
; line=yes + endpoint= above is the first mechanism: Asterisk tags its
; registered Contact with ;line=… and matches an inbound INVITE on that
; tag. VoIP.ms strips the parameter, so the INVITE arrives untagged,
; matches nothing, and is dropped as "No matching endpoint found" — no
; ring, and no log line at the default verbosity. These two blocks
; identify the trunk by our own identity: the sub-account name or the
; DID, in the request URI or the To header. Unlike an IP allow-list
; (match=) this can never go stale when the provider adds a server.
; Put the sub-account and EVERY DID the account answers in the pattern.
; match_request_uri needs Asterisk 20.5 or newer; match_header any.
[voipms-identify-uri]
type=identify
endpoint=voipms
match_request_uri=/(123456_home|5125550100)/

[voipms-identify-to]
type=identify
endpoint=voipms
match_header=To: /(123456_home|5125550100)/

; ─── Handsets ────────────────────────────────────────────────
; GENERATED from handsets.toml — run `doorman render`, copy the output
; here, chown asterisk:asterisk, chmod 640 (it contains real passwords).
; Add a phone by editing handsets.toml, never this file.
; tryinclude, not include: on a fresh box this file is installed before
; `doorman render` has produced the generated one, and a missing #include
; makes Asterisk reject the WHOLE file — no endpoints, no dialplan, and the
; only trace is "declined to load" in messages.log (first install, 2026-09-23).
#tryinclude "pjsip_handsets.conf"

; ─── Home Assistant Assist (optional) ────────────────────────
; A static endpoint at HA's IP for the native VoIP integration — no
; registration, HA just answers. Requires the Opus codec module in Asterisk
; (HA's Assist audio is Opus); see RUNBOOK for the caveats before enabling.
;[homeassistant]
;type=endpoint
;context=internal
;disallow=all
;allow=opus
;allow=ulaw
;aors=homeassistant
;direct_media=no
;
;[homeassistant]
;type=aor
;contact=sip:assist@HA_IP_HERE:5060
