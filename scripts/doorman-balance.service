# Is the calling credit running out? `doorman balance` asks each provider in
# trunks.toml, exits 1 when one is under its threshold, and — when
# BALANCE_RING names a handset in .env — rings it and says so, because an
# internal call never touches a trunk and a dead account can still ring the
# kitchen. BALANCE_PROM, if set, gets a Prometheus textfile on every run.
#
# Run by doorman-balance.timer once a morning. Exits 0 and stays quiet
# without a trunks.toml, which is every single-provider install.
#
# Install:
#   sudo cp scripts/doorman-balance.service scripts/doorman-balance.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now doorman-balance.timer
#
# Know what this puts on the box: the provider's API password, named by
# api_password_env in trunks.toml, which manages DIDs and billing. The ring
# needs the daemon's ARI on loopback, so a run that rings is a run here.
# RUNBOOK, "Watch a prepaid trunk's balance", says what that costs.
#
# If BALANCE_PROM points outside /var/lib/doorman (node_exporter's textfile
# directory, usually), add a drop-in:
#   [Service]
#   ReadWritePaths=/var/lib/node_exporter/textfile_collector
[Unit]
Description=Call Me Maybe — is the calling credit running out
Documentation=https://callmemaybe.cc
After=network-online.target doorman.service
Wants=network-online.target

[Service]
Type=oneshot
User=doorman
Group=doorman
WorkingDirectory=/opt/call-me-maybe
EnvironmentFile=/opt/call-me-maybe/.env
ExecStart=/opt/call-me-maybe/bin/doorman balance -state /var/lib/doorman/balance.json

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/call-me-maybe
StateDirectory=doorman
StateDirectoryMode=0700
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=64M

StandardOutput=journal
StandardError=journal
