---
/**
 * An abstract doorman, built entirely from geometric primitives — circles,
 * trapezoids, rectangles. No traced path data: Art Deco figures were
 * constructed from compass-and-straightedge shapes, so the constraint is the
 * style rather than a limitation.
 *
 * He tips his cap when the lobby admits you. The `.hat` group is the only
 * animated part; the CSS owns that.
 */
---

<svg
  class="doorman"
  viewBox="0 0 160 200"
  role="img"
  aria-labelledby="doorman-title"
  fill="none"
>
  <title id="doorman-title">A doorman in a peaked cap, waiting</title>

  <!-- Sunburst halo: four rays, symmetric, as a Deco portrait frame would be -->
  <g stroke="currentColor" stroke-width="1" opacity="0.28">
    <line x1="80" y1="6" x2="80" y2="26" />
    <line x1="34" y1="20" x2="46" y2="36" />
    <line x1="126" y1="20" x2="114" y2="36" />
  </g>

  <!-- Shoulders: a broad trapezoid, the Deco silhouette -->
  <polygon points="26,200 40,124 120,124 134,200" fill="currentColor" opacity="0.16" />
  <polygon points="26,200 40,124 120,124 134,200" stroke="currentColor" stroke-width="1.5" />

  <!-- Lapels: two mirrored diagonals meeting at the collar -->
  <path d="M80 124 L62 200 M80 124 L98 200" stroke="currentColor" stroke-width="1.5" />
  <path d="M80 124 L58 152 M80 124 L102 152" stroke="currentColor" stroke-width="1.5" />

  <!-- Double-breasted buttons -->
  <g fill="currentColor">
    <circle cx="69" cy="160" r="2.6" />
    <circle cx="91" cy="160" r="2.6" />
    <circle cx="69" cy="178" r="2.6" />
    <circle cx="91" cy="178" r="2.6" />
  </g>

  <!-- Epaulettes: stepped, echoing the ziggurat -->
  <g stroke="currentColor" stroke-width="1.5">
    <path d="M32 132 H50 V138 H36 V144" />
    <path d="M128 132 H110 V138 H124 V144" />
  </g>

  <!-- Head -->
  <circle cx="80" cy="98" r="20" stroke="currentColor" stroke-width="1.5" />
  <!-- Collar -->
  <path d="M64 116 Q80 128 96 116" stroke="currentColor" stroke-width="1.5" />

  <!-- The cap. Grouped so it can be tipped. -->
  <g class="hat">
    <!-- Crown -->
    <path d="M56 78 Q80 58 104 78 Z" fill="currentColor" opacity="0.2" />
    <path d="M56 78 Q80 58 104 78" stroke="currentColor" stroke-width="1.5" />
    <!-- Band -->
    <rect x="54" y="78" width="52" height="7" fill="currentColor" opacity="0.35" />
    <rect x="54" y="78" width="52" height="7" stroke="currentColor" stroke-width="1.5" />
    <!-- Peak -->
    <path d="M50 85 H110 L102 92 H58 Z" fill="currentColor" opacity="0.16" />
    <path d="M50 85 H110 L102 92 H58 Z" stroke="currentColor" stroke-width="1.5" />
    <!-- Cap badge: a tiny stepped motif -->
    <path d="M76 79 H84 V81 H82 V83 H78 V81 H76 Z" fill="currentColor" />
  </g>
</svg>
