# Numbers added from handsets with *88: `doorman phonebook` files each
# recording's number into that phone's own book at once and asks
# STT_ENDPOINT for the spoken name, minutes after the call and never on it.
# Run by doorman-phonebook.timer every minute. With no STT_ENDPOINT the
# number is filed under its number and the recording waits.
#
# Install:
#   sudo cp scripts/doorman-phonebook.service scripts/doorman-phonebook.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now doorman-phonebook.timer
[Unit]
Description=Call Me Maybe — file and name the numbers added with *88
Documentation=https://callmemaybe.cc
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=doorman
Group=doorman
WorkingDirectory=/opt/call-me-maybe
EnvironmentFile=/opt/call-me-maybe/.env
ExecStart=/opt/call-me-maybe/bin/doorman phonebook

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/call-me-maybe
StateDirectory=doorman
StateDirectoryMode=0700
ReadWritePaths=/var/spool/call-me-maybe
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=64M

StandardOutput=journal
StandardError=journal
