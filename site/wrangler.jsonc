{
  // Cloudflare Pages deployment for callmemaybe.cc.
  //
  // Pages rather than Workers static assets, to match the other projects in
  // this account (bullmoose.cc and the tensr.fitness sites are all Pages,
  // deployed from the CLI). One mental model beats a marginally more modern
  // platform for the sixth project.
  //
  //   npm run cf:preview   serve ./dist through the Pages runtime locally
  //   npm run deploy       build, then publish
  //
  // Credentials come from the environment. This repo's .env carries
  // CF_API_TOKEN and CF_ACCOUNT_ID (wrangler still honours those legacy names;
  // CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID are the current ones). .env is
  // gitignored and the pre-push hook refuses a push that tracks it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callmemaybe",
  "compatibility_date": "2026-07-29",

  // Pages serves this directory. It also serves 404.html for unmatched paths
  // by convention, so the Deco "Good day." page needs no extra configuration —
  // unlike Workers static assets, which wants an explicit not_found_handling.
  "pages_build_output_dir": "./dist"

  // Custom domains are NOT configurable here. Pages attaches them through the
  // dashboard (Workers & Pages → callmemaybe → Custom domains); there is no
  // `wrangler pages domain` command. That is the one real cost of choosing
  // Pages: the domain wiring lives outside version control.
  //
  // Current state of the two zones, checked 2026-07-30:
  //   dialdoorman.cc  active  — can serve immediately
  //   callmemaybe.cc  pending — nameservers not yet delegated to Cloudflare at
  //                             the registrar, so attaching it will not resolve
  //                             until the zone activates
  //
  // If dialdoorman.cc is a spare rather than a mirror, point it at
  // callmemaybe.cc with a Redirect Rule on that zone instead of attaching both
  // to the project — two live hostnames both serving the site contradicts the
  // <link rel="canonical"> in Base.astro.
}
