# The house as one sealed file: `doorman backup run` collects .env, the TOMLs,
# the state directory, voicemail and the *88 spool, encrypts them to
# BACKUP_RECIPIENT (the box holds only the public half) and delivers the bundle
# to every destination .env names. Run by doorman-backup.timer nightly.
# Exits 0 and says so when BACKUP_RECIPIENT or every destination is unset.
# Installed and enabled by `sudo doorman init services`; a rerun is the upgrade.
[Unit]
Description=Call Me Maybe — the nightly backup
Documentation=https://callmemaybe.cc
After=doorman.service

[Service]
Type=oneshot
User=doorman
Group=doorman
WorkingDirectory=/opt/call-me-maybe
EnvironmentFile=/opt/call-me-maybe/.env
ExecStart=/opt/call-me-maybe/bin/doorman backup run

NoNewPrivileges=yes
PrivateTmp=yes
# full, not strict: BACKUP_PATH may be anywhere the operator mounts a drive
# (/mnt, /srv, /media); /usr, /boot and /etc stay read-only regardless.
ProtectSystem=full
ProtectHome=yes
ReadOnlyPaths=/opt/call-me-maybe /etc/asterisk /var/spool/asterisk/voicemail /var/spool/call-me-maybe
StateDirectory=doorman
StateDirectoryMode=0700
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

StandardOutput=journal
StandardError=journal
