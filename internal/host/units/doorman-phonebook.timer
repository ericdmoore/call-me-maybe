# Once a minute: a number keyed with *88 is in the phone's directory within
# a minute, and its name as soon after as the transcription service answers.
[Unit]
Description=Call Me Maybe — *88 additions, every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
