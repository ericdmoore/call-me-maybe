---
/**
 * The page frame: paired rules around the viewport with an ornamented corner at
 * each turn and a lozenge stud halfway along each rail. Source geometry lives in
 * brand/ornament-corner.svg and brand/ornament-edge-stud.svg.
 *
 * Fixed to the viewport rather than wrapped around the content, so a long
 * scrolling page still reads as one framed plate — which is what a Deco border
 * is for. `pointer-events: none` throughout: this must never intercept a click
 * or a scroll.
 *
 * One corner is drawn once and mirrored three times with transforms, the way the
 * period cut a single block and took four impressions.
 *
 * Below 44rem the ornaments come off and only the rules remain. On a phone the
 * corners would eat the margin they are supposed to decorate.
 */
---

<div class="page-frame" aria-hidden="true">
  <span class="pf-rail pf-top"></span>
  <span class="pf-rail pf-bottom"></span>
  <span class="pf-rail pf-left"></span>
  <span class="pf-rail pf-right"></span>

  <svg class="pf-corner pf-tl" viewBox="0 0 96 96" fill="none" stroke="currentColor">
    <path d="M8 76 A68 68 0 0 1 76 8" stroke-width="1.4"/>
    <path d="M8 62 A54 54 0 0 1 62 8" stroke-width="1"/>
    <path d="M8 48 A40 40 0 0 1 48 8" stroke-width="1" opacity="0.65"/>
    <g stroke-width="1" opacity="0.7">
      <path d="M20.6 55.6 L25.6 73.7"/>
      <path d="M33.2 44.9 L42 66.9"/>
      <path d="M44.9 33.2 L56.1 56.1"/>
      <path d="M55.6 20.6 L66.9 42"/>
      <path d="M62 8 L73.7 25.6"/>
    </g>
    <rect x="10" y="10" width="17" height="17" stroke-width="1.6"/>
    <rect x="15" y="15" width="7" height="7" fill="currentColor" stroke="none"/>
    <g fill="currentColor" stroke="none" opacity="0.8">
      <circle cx="35" cy="18.5" r="1.7"/>
      <circle cx="44" cy="18.5" r="1.7"/>
      <circle cx="18.5" cy="35" r="1.7"/>
      <circle cx="18.5" cy="44" r="1.7"/>
    </g>
  </svg>

  <svg class="pf-corner pf-tr" viewBox="0 0 96 96" fill="none" stroke="currentColor">
    <path d="M8 76 A68 68 0 0 1 76 8" stroke-width="1.4"/>
    <path d="M8 62 A54 54 0 0 1 62 8" stroke-width="1"/>
    <path d="M8 48 A40 40 0 0 1 48 8" stroke-width="1" opacity="0.65"/>
    <g stroke-width="1" opacity="0.7">
      <path d="M20.6 55.6 L25.6 73.7"/>
      <path d="M33.2 44.9 L42 66.9"/>
      <path d="M44.9 33.2 L56.1 56.1"/>
      <path d="M55.6 20.6 L66.9 42"/>
      <path d="M62 8 L73.7 25.6"/>
    </g>
    <rect x="10" y="10" width="17" height="17" stroke-width="1.6"/>
    <rect x="15" y="15" width="7" height="7" fill="currentColor" stroke="none"/>
    <g fill="currentColor" stroke="none" opacity="0.8">
      <circle cx="35" cy="18.5" r="1.7"/>
      <circle cx="44" cy="18.5" r="1.7"/>
      <circle cx="18.5" cy="35" r="1.7"/>
      <circle cx="18.5" cy="44" r="1.7"/>
    </g>
  </svg>

  <svg class="pf-corner pf-bl" viewBox="0 0 96 96" fill="none" stroke="currentColor">
    <path d="M8 76 A68 68 0 0 1 76 8" stroke-width="1.4"/>
    <path d="M8 62 A54 54 0 0 1 62 8" stroke-width="1"/>
    <path d="M8 48 A40 40 0 0 1 48 8" stroke-width="1" opacity="0.65"/>
    <g stroke-width="1" opacity="0.7">
      <path d="M20.6 55.6 L25.6 73.7"/>
      <path d="M33.2 44.9 L42 66.9"/>
      <path d="M44.9 33.2 L56.1 56.1"/>
      <path d="M55.6 20.6 L66.9 42"/>
      <path d="M62 8 L73.7 25.6"/>
    </g>
    <rect x="10" y="10" width="17" height="17" stroke-width="1.6"/>
    <rect x="15" y="15" width="7" height="7" fill="currentColor" stroke="none"/>
    <g fill="currentColor" stroke="none" opacity="0.8">
      <circle cx="35" cy="18.5" r="1.7"/>
      <circle cx="44" cy="18.5" r="1.7"/>
      <circle cx="18.5" cy="35" r="1.7"/>
      <circle cx="18.5" cy="44" r="1.7"/>
    </g>
  </svg>

  <svg class="pf-corner pf-br" viewBox="0 0 96 96" fill="none" stroke="currentColor">
    <path d="M8 76 A68 68 0 0 1 76 8" stroke-width="1.4"/>
    <path d="M8 62 A54 54 0 0 1 62 8" stroke-width="1"/>
    <path d="M8 48 A40 40 0 0 1 48 8" stroke-width="1" opacity="0.65"/>
    <g stroke-width="1" opacity="0.7">
      <path d="M20.6 55.6 L25.6 73.7"/>
      <path d="M33.2 44.9 L42 66.9"/>
      <path d="M44.9 33.2 L56.1 56.1"/>
      <path d="M55.6 20.6 L66.9 42"/>
      <path d="M62 8 L73.7 25.6"/>
    </g>
    <rect x="10" y="10" width="17" height="17" stroke-width="1.6"/>
    <rect x="15" y="15" width="7" height="7" fill="currentColor" stroke="none"/>
    <g fill="currentColor" stroke="none" opacity="0.8">
      <circle cx="35" cy="18.5" r="1.7"/>
      <circle cx="44" cy="18.5" r="1.7"/>
      <circle cx="18.5" cy="35" r="1.7"/>
      <circle cx="18.5" cy="44" r="1.7"/>
    </g>
  </svg>

  <svg class="pf-stud pf-stud-top" viewBox="0 0 64 34" fill="none" stroke="currentColor">
    <path d="M12 6 A20 20 0 0 0 52 6" stroke-width="1.2"/>
    <g stroke-width="1" opacity="0.6">
      <path d="M32 6 L18 9.5"/><path d="M32 6 L24 12.6"/><path d="M32 6 L32 14"/>
      <path d="M32 6 L40 12.6"/><path d="M32 6 L46 9.5"/>
    </g>
    <path d="M32 0 L42 10 L32 20 L22 10 Z" stroke-width="1.6"/>
    <path d="M32 5 L37 10 L32 15 L27 10 Z" fill="currentColor" stroke="none"/>
  </svg>

  <svg class="pf-stud pf-stud-bottom" viewBox="0 0 64 34" fill="none" stroke="currentColor">
    <path d="M12 6 A20 20 0 0 0 52 6" stroke-width="1.2"/>
    <g stroke-width="1" opacity="0.6">
      <path d="M32 6 L18 9.5"/><path d="M32 6 L24 12.6"/><path d="M32 6 L32 14"/>
      <path d="M32 6 L40 12.6"/><path d="M32 6 L46 9.5"/>
    </g>
    <path d="M32 0 L42 10 L32 20 L22 10 Z" stroke-width="1.6"/>
    <path d="M32 5 L37 10 L32 15 L27 10 Z" fill="currentColor" stroke="none"/>
  </svg>
</div>
